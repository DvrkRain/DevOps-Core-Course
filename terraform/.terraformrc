# Use Yandex Cloud mirror when registry.terraform.io is unreachable.
# Usage (from terraform/ directory):
#   PowerShell: $env:TF_CLI_CONFIG_FILE = (Join-Path $PWD '.terraformrc'); terraform init
#   Bash:      export TF_CLI_CONFIG_FILE="$PWD/.terraformrc"; terraform init
# Or copy this file to your Terraform config location:
#   Windows: %APPDATA%\terraform.rc
#   Linux/macOS: ~/.terraformrc

provider_installation {
  network_mirror {
    url     = "https://terraform-mirror.yandexcloud.net/"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
